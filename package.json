{
  "name": "@local/dsh-model-selector-config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "模型选择器配置：控制任意 provider 的模型可见性，并设定每模型/每 provider 的默认思考等级（热生效，无需重启）。",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "node_modules/yaml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1",
    "react": "^18.3.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
